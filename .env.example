# Required: generate a strong random value, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
COOKIE_SECURE=false
TRUST_PROXY=true
PORT=5000

# Local SQLite default. For deployment use PostgreSQL, e.g. postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=sqlite:///study_scheduler.db

# No Google OAuth required. Email/password registration uses a one-time email code.

# Redis broker: local redis://localhost:6379/0 or managed Redis TLS URL (rediss://...)
REDIS_URL=redis://localhost:6379/0

# Brevo transactional email API. No SMTP credentials/ports are used.
BREVO_API_KEY=
# Sender address must be verified/authorized in Brevo. Recipients can be arbitrary valid addresses once your account is approved for production sending.
EMAIL_FROM=
EMAIL_FROM_NAME=TaskScheduler and DeadlineManager
# Optional comma-separated extra disposable-email domains to block.
DISPOSABLE_EMAIL_DOMAINS=
